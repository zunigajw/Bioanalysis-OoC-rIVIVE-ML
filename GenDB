# GenDB: builds output/ooc_drug_ml.db plus one spreadsheet per database in output/.
# Called by the justfile inside the Podman container (make -f GenDB). The stages can also be run
# one at a time (make -f GenDB schema, rdkit, chembl, ice, database), which GitHub does to draw the flow.
PYTHON ?= python
OUT    := output
DB     := $(OUT)/ooc_drug_ml.db
TMP    := $(OUT)/building.db
STAGES := schema rdkit chembl ice database

.PHONY: all clean $(STAGES)
all: $(DB)

# Starts from an empty database every time and replaces the old one only if every stage succeeds,
# so running it again gives the same database. Downloads are cached in output/cache.
$(DB): Data_Pipeline.sql requirements.txt $(wildcard Source_Code/*.py) $(wildcard Project_Files/*)
	$(MAKE) -f GenDB $(STAGES)

schema:
	mkdir -p $(OUT)
	rm -f $(TMP)
	$(PYTHON) -c "import sqlite3; sqlite3.connect('$(TMP)').executescript(open('Data_Pipeline.sql').read())"

rdkit:
	$(PYTHON) Source_Code/rdkit_features.py $(TMP)

chembl:
	$(PYTHON) Source_Code/chembl.py $(TMP)

ice:
	$(PYTHON) Source_Code/ice.py $(TMP)

database:
	mv $(TMP) $(DB)

clean:
	rm -rf $(OUT)
